{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/download/:path*",
      "destination": "https://github.com/IncludeSpecial/GetBox/releases/download/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/screenshots/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
